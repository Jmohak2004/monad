# ---- Public (shipped to the browser) ----
NEXT_PUBLIC_CHAIN_ID=10143
# Alchemy Monad endpoint; falls back to the public RPC if empty
NEXT_PUBLIC_RPC_URL=https://monad-testnet.g.alchemy.com/v2/<ALCHEMY_KEY>
# From contracts/deployments/<chainId>.json
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_REQUESTS_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_TOKEN_IS_MOCK=true
# Envio HyperIndex GraphQL endpoint (optional; history falls back to on-device + on-chain reads)
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql
# ---- Server only ----
# Pays gas for recipients' claims (and the testnet faucet). Fund with MON.
RELAYER_PRIVATE_KEY=
# Aurora Intents API key from https://studio.aurora.dev
AURORA_API_KEY=
AURORA_DESTINATION_ASSET=AUSD

# ---- Android app (android/) ----
# Package name and signing-cert SHA-256 fingerprints for /.well-known/assetlinks.json
ANDROID_PACKAGE_NAME=io.github.jmohak2004.ghar
ANDROID_SHA256_CERT_FINGERPRINTS=
